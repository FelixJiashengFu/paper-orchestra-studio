# PaperOrchestra Backend Environment Variables (Template)
# Fill in at least one LLM provider key (Anthropic, DeepSeek, OpenAI, or Gemini/Vertex AI).

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

OPENAI_API_KEY=
OPENAI_BASE_URL=

GEMINI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=

# Optional (recommended for higher accuracy & strict 1 req/s rate limit;
# OpenAlex, arXiv, and Crossref are enabled automatically as fallbacks):
SEMANTIC_SCHOLAR_API_KEY=

# Optional email for polite Crossref / OpenAlex User-Agent headers & notifications:
SMTP_EMAIL=
SMTP_PASSWORD=
