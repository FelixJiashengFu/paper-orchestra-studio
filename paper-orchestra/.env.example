# PaperOrchestra Backend Environment Variables (Template)
# Fill in at least one LLM provider key (Anthropic, DeepSeek, OpenAI, or Gemini/Vertex AI).

# Or use no key at all: PO_HOST_AGENT=muse sends every LLM step to your signed-in
# Meta Muse Code CLI (`muse exec`) and calls no other LLM API. The Muse plugin
# (plugins/muse) turns this on by itself; set it here only to make the desktop
# app and every other plugin use Muse too. See docs/PROVIDERS_zh.md, section 12.
# PO_HOST_AGENT=muse

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

OPENAI_API_KEY=
OPENAI_BASE_URL=

GEMINI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=

# Optional (recommended for higher accuracy & strict 1 req/s rate limit;
# OpenAlex, arXiv, and Crossref are enabled automatically as fallbacks):
SEMANTIC_SCHOLAR_API_KEY=

# Optional email for polite Crossref / OpenAlex User-Agent headers & notifications:
SMTP_EMAIL=
SMTP_PASSWORD=

# Optional: Zotero and Overleaf sync (plugins `po_reference_sync` tool)
# ZOTERO_API_KEY=
# ZOTERO_USER_ID=
# ZOTERO_GROUP_ID=
# OVERLEAF_GIT_TOKEN=
