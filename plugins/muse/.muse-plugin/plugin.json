{
  "schemaVersion": 1,
  "name": "paper-orchestra-studio",
  "displayName": "PaperOrchestra Studio",
  "version": "1.2.0",
  "description": "End-to-end AI scientific paper workbench: multi-agent paper pipeline, 19 venue LaTeX templates, XeLaTeX/SyncTeX workbench, 8-source literature graph, Research Studio SOPs, figure studio, Nature and Lean 4 audits, reviewer response, venue preflight, claim-evidence audit, talk and poster kits, HTML/Word/PDF export and SSH/GPU management. Muse edition: every model call runs on your own Muse sign-in, no other LLM API.",
